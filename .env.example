# Copy to .env and change every value. .env is git-ignored; never commit it.

# InfluxDB (first-start setup of the container, and the ground station's write target)
INFLUX_USERNAME=mission
INFLUX_PASSWORD=change-me-influx-password
INFLUX_ORG=satsim
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=change-me-long-random-token
INFLUX_URL=http://localhost:8086

# Grafana admin login (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Alert webhook (Discord channel webhook URL). If left empty, alerts still show in Grafana,
# but each notification fails and Grafana logs a Discord "Unknown Webhook" error.
ALERT_WEBHOOK_URL=
