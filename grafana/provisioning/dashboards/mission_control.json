{
  "uid": "mission-control",
  "title": "Mission Control",
  "tags": [
    "satellite",
    "generated"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "state-timeline",
      "title": "Sunlight / eclipse",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "interval": "2s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"truth\" and r.source == \"truth\")\n  |> filter(fn: (r) => r._field == \"eclipse\")\n  |> toInt()\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> set(key: \"_field\", value: \"Truth\")"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"housekeeping\" and r.source == \"fsw\")\n  |> filter(fn: (r) => r._field == \"sun_present\")\n  |> map(fn: (r) => ({r with _value: 1 - r._value}))\n  |> toInt()\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> set(key: \"_field\", value: \"FSW sun sensor\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SUNLIGHT",
                  "color": "#eda100",
                  "index": 0
                },
                "1": {
                  "text": "ECLIPSE",
                  "color": "#52514e",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "center",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1
    },
