          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"compute\" and r.runner == \"${runner}\")\n  |> filter(fn: (r) => r._field == \"wall_s\")\n  |> group()\n  |> count()"
